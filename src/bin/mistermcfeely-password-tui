#!/usr/bin/env python3
# mistermcfeely-password-tui
# Standalone TUI for managing member and shared mailbox passwords

import sys
import os

# Add src to path for imports
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from bbsengine6 import engine
from bbsengine6.io import echo
from postoffice.tui.password_manager import PasswordManager


def main() -> int:
    """Main entry point."""
    try:
        # Initialize bbsengine6 session
        args = engine.start()
        
        # Require login
        if not args.loginid:
            echo("You must be logged in to use the password manager", level="error")
            return 1
        
        # Start password manager TUI
        pm = PasswordManager(args)
        return pm.run()
        
    except KeyboardInterrupt:
        echo("", level="info")
        echo("Interrupted", level="info")
        return 130
    except Exception as e:
        echo(f"Error: {e}", level="error")
        return 1


if __name__ == "__main__":
    sys.exit(main())
