# /etc/pam.d/imap -- PAM stack for Cyrus IMAP connections
#
# Cyrus's sasl_pwcheck_method: auxprop / sasl_auxprop_plugin: pam
# path uses pam_pwcheck_service: imap (set in /etc/postoffice/imapd.conf).
# libsasl2 then opens this PAM service.
#
# The full BBS auth stack lives in /etc/pam.d/bbsengine6. We include
# it here rather than duplicating the rules so the two paths (Dovecot
# on merlin, Cyrus on falcon) share one definition.
#
# For system accounts (root, cyrus, postoffice) that don't have a
# BBS row, the bbsengine6 helper returns PAM_AUTH_ERR and the
# pam_unix.so sufficient rule in /etc/pam.d/bbsengine6 catches them.

auth        include      bbsengine6
account     include      bbsengine6
