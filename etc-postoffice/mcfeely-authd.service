# mcfeely-authd.service
# Systemd unit for mcfeely-authd SASL authentication daemon
# Installs: sudo cp this file to /etc/systemd/system/
# Prereq: postoffice user must exist. Create with:
#   sudo useradd -r -d /var/run/mcfeely-authd -s /sbin/nologin postoffice
#   sudo mkdir -p /var/run/mcfeely-authd /var/log/mcfeely-authd.log
#   sudo chown postoffice:postoffice /var/run/mcfeely-authd /var/log/mcfeely-authd.log

[Unit]
Description=mcfeely-authd SASL authentication daemon for mistermcfeely
Documentation=https://github.com/anomalyco/mistermcfeely
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=forking
User=postoffice
Group=postoffice
ExecStart=/home/opencode/.venv/bin/python -m mcfeely_authd --config /etc/mcfeely-authd.conf
PIDFile=/var/run/mcfeely-authd/mcfeely-authd.pid
Restart=on-failure
RestartSec=5s

RuntimeDirectory=mcfeely-authd
RuntimeDirectoryMode=0755

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcfeely-authd

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

ReadWritePaths=/var/log/mcfeely-authd.log

[Install]
WantedBy=multi-user.target