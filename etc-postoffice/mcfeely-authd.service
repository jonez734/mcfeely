# mcfeely-authd.service
# Systemd unit for mcfeely-authd SASL authentication daemon
# Installs: sudo cp this file to /usr/lib/systemd/system/
# Prereq: postoffice user must exist. Create with:
#   sudo useradd -r -d /var/lib/postoffice -s /sbin/nologin postoffice
# Or use systemd-sysusers: sudo systemd-sysusers postoffice.sysusers

[Unit]
Description=mcfeely-authd SASL authentication daemon for mistermcfeely
Documentation=https://github.com/anomalyco/mistermcfeely
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=postoffice
Group=postoffice
WorkingDirectory=/var/lib/postoffice

ExecStart=@VENV_DIR@/bin/mcfeely-authd --foreground --config /etc/postoffice/mcfeely-authd.conf

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30s

RuntimeDirectory=mcfeely-authd
RuntimeDirectoryMode=0755

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcfeely-authd

[Install]
WantedBy=multi-user.target
